# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local  : mongodb://127.0.0.1:27017/meridian
# Atlas  : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/meridian
MONGODB_URI=mongodb://127.0.0.1:27017/meridian

# ---- Auth ----
# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# ---- Payments ----
# UPI QR (manual verification) + Cash on Delivery. No gateway keys needed.

# ---- Seed admin (used by `npm run seed`) ----
ADMIN_NAME=Meridian Admin
ADMIN_EMAIL=admin@meridian.store
ADMIN_PASSWORD=Admin@123
